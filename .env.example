# ============================================================
#  NioPets environment variables
#  Copy to .env and fill in. NEVER commit .env
#  NEVER put any of these in HTML, CSS or browser JavaScript.
# ============================================================

# ---- Whop: SERVER ONLY, these are secrets ----
WHOP_API_KEY=your_secret_api_key_here
WHOP_COMPANY_ID=your_company_id_here
WHOP_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ---- Where orders are emailed ----
WEB3FORMS_KEY=your_web3forms_access_key_here
ORDER_EMAILS=wahabilyas205@gmail.com,wahabilyas206@gmail.com

# ---- Private admin dashboard ----
# Generate a long random value and keep it server-side only.
ADMIN_TOKEN=replace_with_a_long_random_admin_token
ADMIN_EMAIL=wahabilyas205@gmail.com
ADMIN_PASSWORD=wahabilyas205@gmail.com

# ---- Public site URL, used for the Whop redirect ----
SITE_URL=https://niopets.online

# Whop checkout host (production default). Override for sandbox if needed.
WHOP_CHECKOUT_BASE=https://whop.com
# WHOP_API_BASE=https://api.whop.com/api/v1

# ---- Durable key value store. REQUIRED before taking real money. ----
# Supabase is preferred. The secret key is server-only; never use it in JS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key_here

# Optional Upstash fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Shipping and tax. Read the README before changing TAX_RATE. ----
SHIPPING_FEE=0
TAX_RATE=0
# ============================================================
#  NioPets environment variables
#
#  Save this file as  .env  in your project root.
#  It is already listed in .gitignore, so it will not be committed.
#  NEVER put any of these in HTML, CSS or browser JavaScript.
#
#  On Vercel you do NOT upload this file. You paste each
#  KEY / VALUE pair into:
#     Project -> Settings -> Environment Variables
#  then redeploy.
# ============================================================


# ------------------------------------------------------------
# WHOP: SERVER ONLY, THESE ARE SECRETS
# ------------------------------------------------------------

# STILL NEEDED. The key you shared earlier is burned, so create a
# fresh one and paste it here:
#   whop.com/dashboard -> Developer -> API keys -> Create
#   Copy it from the modal, it is shown only once.
#   Starts with: apik_
WHOP_API_KEY=paste_your_NEW_rotated_key_here

# CONFIRMED, taken from your dashboard URL
WHOP_COMPANY_ID=biz_6liUhLWOIZ3ar7

# STILL NEEDED. This does not exist until you create the webhook:
#   whop.com/dashboard -> Developer -> Webhooks -> Create webhook
#   URL:     https://niopets.online/api/webhooks/whop
#   Events:  payment.created, payment.pending, payment.succeeded,
#            payment.failed, refund.created, refund.updated
#   API version: v1   (not v2, not v5)
#   Then copy the signing secret from the Secret column.
#   Starts with: ws_
WHOP_WEBHOOK_SECRET=paste_your_webhook_signing_secret_here


# ------------------------------------------------------------
# WHERE ORDERS ARE EMAILED
# ------------------------------------------------------------

# CONFIRMED, your Web3Forms access key
WEB3FORMS_KEY=paste_your_web3forms_access_key_here

# CONFIRMED, where the PAID order emails land
ORDER_EMAILS=wahabilyas205@gmail.com,wahabilyas206@gmail.com


# ------------------------------------------------------------
# PUBLIC SITE URL, used for the Whop redirect after payment
# ------------------------------------------------------------

# CONFIRMED, your domain
SITE_URL=https://niopets.online


# ------------------------------------------------------------
# DURABLE KEY VALUE STORE
# Required before you take real money. Without it, a retried
# webhook is processed twice and you ship one order twice.
# ------------------------------------------------------------

# STILL NEEDED. Free tier, takes about two minutes:
#   1. Sign up at upstash.com
#   2. Create Database -> Redis -> pick a US region
#   3. Open the database, scroll to "REST API"
#   4. Copy UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------------------------------------------------------------
# SHIPPING AND TAX
# ------------------------------------------------------------

# Free shipping on every order, so this stays 0
SHIPPING_FEE=0

# Leave at 0 until a US sales tax accountant tells you otherwise.
# You are selling into the US from Pakistan, so nexus rules vary
# by state and by your sales volume. 0.0825 would be 8.25%.
TAX_RATE=0

